---
import { createRequire } from 'node:module';
import FigureViewport from './FigureViewport.astro';
const require = createRequire(`${process.cwd()}/package.json`);
const katex = createRequire(require.resolve('rehype-katex'))('katex');
const tex = (source: string) => katex.renderToString(source, { throwOnError: true });
---
<figure id="ff-descent" class="ff-descent">
  <FigureViewport width={480}>
    <div class="descent-canvas" role="img" aria-label="The density differential delta advances the complex stage and its square is zero. Translation partial raises internal weight. In the commuting square, f has weight m plus one, h has weight m, and delta f equals partial h. Therefore partial delta h equals zero; injectivity of partial on C squared implies delta h equals zero.">
      <div class="chain">
        <span set:html={tex('C^0')} />
        <span class="right" set:html={tex('\\xrightarrow{\\delta}')} />
        <span set:html={tex('C^1')} />
        <span class="right" set:html={tex('\\xrightarrow{\\delta}')} />
        <span set:html={tex('C^2')} />
      </div>
      <div class="chain-rule" set:html={tex('\\delta\\circ\\delta=0')} />
      <div class="square">
        <div class="node" set:html={tex('C^0_m')} />
        <div class="horizontal" aria-hidden="true"><span set:html={tex('\\delta')} /><i></i></div>
        <div class="node"><span set:html={tex('C^1_m')} /><small set:html={tex('h')} /></div>
        <div class="vertical" aria-hidden="true"><i></i><span set:html={tex('\\partial')} /></div>
        <div class="commutes" set:html={tex('\\delta\\partial=\\partial\\delta')} />
        <div class="vertical" aria-hidden="true"><i></i><span set:html={tex('\\partial')} /></div>
        <div class="node"><span set:html={tex('C^0_{m+1}')} /><small set:html={tex('f')} /></div>
        <div class="horizontal" aria-hidden="true"><span set:html={tex('\\delta')} /><i></i></div>
        <div class="node"><span set:html={tex('C^1_{m+1}')} /><small set:html={tex('\\delta f=\\partial h')} /></div>
      </div>
      <div class="conclusion" set:html={tex('\\partial\\delta h=\\delta^2 f=0\\quad\\Longrightarrow\\quad\\delta h=0')} />
      <div class="condition" set:html={tex('\\partial:C^2_m\\longrightarrow C^2_{m+1}\\ \\text{is injective}')} />
    </div>
  </FigureViewport>
</figure>
<style>
.ff-descent{margin:1.7rem 0;color:var(--ink)}.descent-canvas{padding:10px 8px 16px;box-sizing:border-box}.chain{display:grid;grid-template-columns:1fr 64px 1fr 64px 1fr;align-items:center;text-align:center;font-size:23px}.right{color:var(--accent)}.chain-rule{text-align:center;font-size:19px;margin:7px 0 13px;color:var(--muted)}.square{display:grid;grid-template-columns:158px 148px 158px;grid-template-rows:72px 82px 72px;align-items:center}.node{text-align:center;font-size:24px}.node small{display:block;font-size:21px;margin-top:6px}.horizontal{position:relative;align-self:stretch;display:flex;justify-content:center;font-size:20px;color:var(--accent)}.horizontal span{position:absolute;top:4px}.horizontal i{position:absolute;height:1.5px;background:currentColor;left:9px;right:9px;top:42px}.horizontal i::after{content:'';position:absolute;right:0;top:-3px;width:7px;height:7px;border-top:1.5px solid;border-right:1.5px solid;transform:rotate(45deg)}.vertical{position:relative;height:100%;color:var(--accent);font-size:21px}.vertical i{position:absolute;width:1.5px;background:currentColor;top:4px;bottom:4px;left:50%}.vertical i::after{content:'';position:absolute;bottom:0;left:-3px;width:7px;height:7px;border-bottom:1.5px solid;border-right:1.5px solid;transform:rotate(45deg)}.vertical span{position:absolute;left:calc(50% + 12px);top:24px}.commutes{text-align:center;font-size:17px;color:var(--muted)}.conclusion{text-align:center;font-size:19px;margin-top:20px}.condition{text-align:center;font-size:17px;margin-top:9px;color:var(--muted)}.ff-descent :global(.katex){color:inherit}
</style>
