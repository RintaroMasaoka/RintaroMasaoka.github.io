---
import FigureViewport from './FigureViewport.astro';
import { createRequire } from 'node:module';
import { paths, X, Y, EX, WY } from '../visuals/green-response.js';
const require = createRequire(new URL('../../../package.json',import.meta.url));
const katex=createRequire(require.resolve('rehype-katex'))('katex');
const tex=(s:string)=>katex.renderToString(s,{throwOnError:true});
const {stage='matching'}=Astro.props;
const matching=stage==='matching', id=`green-${stage}`, initial=paths(-1.8);
const labels=matching?[
 {x:120,y:0,w:250,t:'\\text{decaying solutions}'},
 {x:2,y:29,w:98,t:'f/f(0)'}, {x:441,y:223,w:30,t:'x'},
 {x:19,y:216,w:30,t:'0'}, {x:19,y:Y(1)-16,w:30,t:'1'},
 ...[-4,0,4].map(x=>({x:X(x)-25,y:237,w:50,t:String(x)})),
 {x:120,y:267,w:250,t:'\\text{Wronskian}'},
 {x:3,y:292,w:53,t:'W(k)'}, {x:442,y:413,w:30,t:'E'},
 {x:19,y:WY(0)-16,w:30,t:'0'},
 ...[-2,-1,-.5].map(e=>({x:EX(e)-29,y:415,w:58,t:String(e)})),
]:[
 {x:90,y:0,w:310,t:'(E+1)G(x,0;k)'},
 {x:441,y:220,w:30,t:'x'}, {x:12,y:214,w:35,t:'0'}, {x:3,y:109,w:47,t:'0.5'},
 ...[-4,0,4].map(x=>({x:X(x)-25,y:237,w:50,t:String(x)})),
];
---
<figure class="green-response" data-green-stage={stage} aria-labelledby={`${id}-caption`}>
  <div class="green-controls">
    <label for={`${id}-energy`}><span>エネルギー <span set:html={tex('E=k^2')} /></span><output data-green-energy-output for={`${id}-energy`}>−1.80</output><input data-green-energy id={`${id}-energy`} type="range" min="-2.25" max="-.25" step=".01" value="-1.8" /></label>
    <div class="green-buttons"><button data-green-pole type="button"><span set:html={tex('E=-1')} /> に合わせる</button><button data-green-reset type="button">初期値に戻す</button></div>
    {matching && <div class="green-w-value"><span set:html={tex('W(k)')} /><span> = </span><output data-green-w>{initial.Wvalue.toFixed(3)}</output></div>}
    <p data-green-status role="status" aria-live="polite">{matching?'接続点の値は一致するが、左右の傾きは異なる。':'エネルギーを E = −1 に近づけると、極の係数の形に近づく。'}</p>
  </div>
  <FigureViewport width={480} label={matching?'減衰解とWronskianの図を左右にスクロール':'極の係数の図を左右にスクロール'}>
    <svg viewBox={`0 0 480 ${matching?455:280}`} role="img" aria-labelledby={`${id}-title ${id}-desc`}>
      <title id={`${id}-title`}>{matching?'Boundary matching and its determinant':'Normalized bound-state pole coefficient'}</title>
      <desc id={`${id}-desc`}>{matching?'Left and right decaying solutions of the minus two sech squared potential are separately scaled to value one at zero. Their tangent slopes agree at energy minus one, where the Wronskian below crosses zero.':'The pole-removed response (E plus one) G from a source at zero is compared with the bound-state projector sech x over two. The curves agree as E approaches minus one. At the eigenvalue the continuous limiting response is drawn.'}</desc>
      <defs><clipPath id={`${id}-clip`}><rect x="56" y="50" width="384" height="185" /></clipPath></defs>
      <path d="M56 56 V232 H440" fill="none" stroke="var(--muted)" stroke-width="1.2" />
      {[-4,0,4].map(x=><path d={`M${X(x)} 232 v5`} stroke="var(--muted)" />)}
      {matching ? <>
        <path d={`M${X(0)} 55 V232 M56 ${Y(1)} H440`} fill="none" stroke="var(--line)" stroke-dasharray="3 5" />
        <g clip-path={`url(#${id}-clip)`}>
          <path data-green-path="left" d={initial.left} fill="none" stroke="var(--accent)" stroke-width="2.7" />
          <path data-green-path="right" d={initial.right} fill="none" stroke="var(--accent)" stroke-width="2.7" stroke-dasharray="7 4" />
          <path data-green-path="leftTangent" d={initial.leftTangent} fill="none" stroke="var(--ink)" stroke-width="1.5" />
          <path data-green-path="rightTangent" d={initial.rightTangent} fill="none" stroke="var(--ink)" stroke-width="1.5" />
        </g>
        <circle cx={X(0)} cy={Y(1)} r="3" fill="var(--ink)" />
        <path d={`M56 303 V410 H440 M56 ${WY(0)} H440`} fill="none" stroke="var(--muted)" stroke-width="1.1" />
        <path d={`M${EX(-1)} 303 V410`} stroke="var(--line)" stroke-dasharray="3 5" />
        <path d={initial.W} fill="none" stroke="var(--accent)" stroke-width="2.5" />
        <circle data-green-marker cx={initial.marker[0]} cy={initial.marker[1]} r="5" fill="var(--ink)" stroke="var(--paper)" stroke-width="1.5" />
        {[-2,-1,-.5].map(e=><path d={`M${EX(e)} 410 v5`} stroke="var(--muted)" />)}
      </> : <g clip-path={`url(#${id}-clip)`}>
        <path d={initial.projector} fill="none" stroke="var(--muted)" stroke-width="4.5" stroke-dasharray="8 5" />
        <path data-green-path="regularized" d={initial.regularized} fill="none" stroke="var(--accent)" stroke-width="2.6" />
      </g>}
      {labels.map(l=><foreignObject x={l.x} y={l.y} width={l.w} height="34"><div class="green-tex" set:html={tex(l.t)} /></foreignObject>)}
    </svg>
    <div class="green-legend">
      {matching ? <>
        <div><svg viewBox="0 0 35 12" aria-hidden="true"><path d="M1 6 H34" stroke="var(--accent)" stroke-width="2.7" /></svg><span set:html={tex('f_-(x,-k)/f_-(0,-k)')} /></div>
        <div><svg viewBox="0 0 35 12" aria-hidden="true"><path d="M1 6 H34" stroke="var(--accent)" stroke-width="2.7" stroke-dasharray="7 4" /></svg><span set:html={tex('f_+(x,k)/f_+(0,k)')} /></div>
      </> : <>
        <div><svg viewBox="0 0 35 12" aria-hidden="true"><path d="M1 6 H34" stroke="var(--accent)" stroke-width="2.7" /></svg><span set:html={tex('(E+1)G(x,0;k)')} /></div>
        <div><svg viewBox="0 0 35 12" aria-hidden="true"><path d="M1 6 H34" stroke="var(--muted)" stroke-width="4.5" stroke-dasharray="8 5" /></svg><span set:html={tex('\\psi_1(x)\\psi_1(0)=1/(2\\cosh x)')} /></div>
      </>}
    </div>
  </FigureViewport>
  <figcaption id={`${id}-caption`}>{matching ? <>上段は左右から減衰条件を満たす解を作り、接続点の値を1にそろえたもの。細い線は接続点での接線である。下段の点は選択したエネルギーに対応する Wronskian を示す。値と傾きが一致すると行列式が0になる。</> : <>実線は点源の応答から極の分母を除いた量、破線は規格化された束縛状態への射影の積分核。固有値に近づくと二つの曲線が一致する。図のエネルギーは前の接続図と連動している。</>}</figcaption>
</figure>
<script>
  import { initGreenResponse } from '../visuals/green-response.js';
  initGreenResponse();
</script>
<style>
.green-response{margin:2rem 0;border:1px solid var(--line);border-radius:12px;padding:1rem;background:var(--paper)}
.green-controls{max-width:480px;margin:0 auto .6rem;font-size:.9rem;line-height:1.7}
.green-controls label{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:.2rem .7rem}
.green-controls input{grid-column:1/-1;width:100%;min-height:44px;accent-color:var(--accent)}
.green-controls output{font-variant-numeric:tabular-nums;color:var(--accent)}
.green-buttons{display:flex;flex-wrap:wrap;gap:.5rem;margin:.4rem 0}
.green-buttons button{border:1px solid var(--line);border-radius:6px;min-height:44px;padding:.25rem .65rem;background:var(--paper);color:var(--ink);font:inherit;cursor:pointer}
.green-controls :is(input,button):focus-visible{outline:2px solid var(--accent);outline-offset:3px}
.green-controls p{margin:.4rem 0 0;min-height:3.4em;color:var(--muted);font-size:.86rem}
.green-w-value{display:flex;gap:.35rem;align-items:baseline}
.green-response svg{display:block;width:480px;height:auto}
.green-tex{display:flex;align-items:center;justify-content:center;color:var(--ink);font-size:19px;line-height:1;height:100%;white-space:nowrap}
.green-legend{display:grid;gap:.45rem;margin:.25rem auto .5rem;width:450px;font-size:18px;color:var(--ink)}
.green-legend>div{display:flex;gap:.6rem;align-items:center;justify-content:center;min-height:30px}
.green-legend svg{width:35px;height:12px;flex:none}
.green-response figcaption{font-size:.88rem;color:var(--muted);line-height:1.8;margin:.5rem 0 0}
</style>
