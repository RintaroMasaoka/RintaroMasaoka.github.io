---
const { width = 480, label = 'Scroll figure horizontally' } = Astro.props;
---
<div class="kdv-figure-viewport" role="region" aria-label={label} tabindex="0">
  <div class="kdv-figure-canvas" style={`width:${width}px`}><slot /></div>
</div>
<div class="kdv-scroll-hint" aria-hidden="true" hidden>← Scroll figure horizontally →</div>
<style>
.kdv-figure-viewport{max-width:100%;overflow-x:auto;overscroll-behavior-x:contain;padding:8px 0;scrollbar-width:thin;scrollbar-color:var(--muted) var(--paper)}
.kdv-figure-viewport:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.kdv-figure-canvas{flex:none;max-width:none;margin:0 auto}
.kdv-scroll-hint{font:12px/1.6 -apple-system,BlinkMacSystemFont,sans-serif;color:var(--muted);text-align:center;margin:.2rem 0 .65rem}
.kdv-scroll-hint[hidden]{display:none}
</style>
