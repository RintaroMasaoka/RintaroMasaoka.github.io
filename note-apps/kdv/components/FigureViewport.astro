---
const {width=480}=Astro.props;
---
<div class="kdv-figure-viewport" data-figure-scale>
  <div class="kdv-figure-canvas" style={`width:${width}px`}><slot /></div>
</div>
<script>
 document.querySelectorAll<HTMLElement>('[data-figure-scale]').forEach(frame=>{
  if(frame.dataset.ready)return;frame.dataset.ready='true';
  const canvas=frame.firstElementChild as HTMLElement;
  const draw=()=>{const scale=frame.clientWidth/canvas.offsetWidth;canvas.style.transform=`scale(${scale})`;frame.style.height=`${canvas.offsetHeight*scale}px`;};
  const observer=new ResizeObserver(draw);observer.observe(frame);observer.observe(canvas);draw();
 });
</script>
<style>
.kdv-figure-viewport{box-sizing:border-box;inline-size:100%;min-inline-size:0;position:relative;overflow:clip}
.kdv-figure-canvas{position:absolute;left:0;top:0;transform-origin:0 0;max-width:none}
</style>
