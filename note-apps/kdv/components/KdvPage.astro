---
import '../scripts/check-section-sync.mjs';
import '../scripts/check-uniform-figures.mjs';
import '../styles/figures.css';
import { Content as GlmContent, getHeadings as getGlmHeadings } from '../content/glm.md';
import { Content, getHeadings } from '../content/full.md';
import { composeHeadings } from '../scripts/headings.mjs';
import KdvBody from '../components/KdvBody.astro';
import config from '../note.config.json';
import { Content as QuantumContent } from '../content/sections/quantization.md';
import { Content as W3Content } from '../content/sections/w3.md';
import FormalCommutator from '../components/FormalCommutator.astro';
import FormalSquareRoot from '../components/FormalSquareRoot.astro';
import DressingSquare from '../components/DressingSquare.astro';
import ScatteringChannels from '../components/ScatteringChannels.astro';
import JostEnds from '../components/JostEnds.astro';
import BoundTail from '../components/BoundTail.astro';
import PointSpectrum from '../components/PointSpectrum.astro';
import MatchingFigure from '../components/MatchingFigure.astro';
import ImaginaryJost from '../components/ImaginaryJost.astro';
import ContourFigure from '../components/ContourFigure.astro';
import ReconstructionFigure from '../components/ReconstructionFigure.astro';
import TravelingSoliton from '../components/TravelingSoliton.astro';
import Determinant from '../components/Determinant.astro';
import BoundStates from '../components/BoundStates.astro';
import KdvSimulation from '../components/KdvSimulation.astro';
const { chapterId, landing = false } = Astro.props;
const sourceHeadings = composeHeadings(getHeadings(), getGlmHeadings());

const headings = sourceHeadings.map(h => ({id: h.slug, depth: h.depth, labelHtml: h.text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;'), href: `#${h.slug}`}));
---
<KdvBody note={config} headings={headings} chapterId={chapterId} landing={landing}><Content /><QuantumContent slot="quantization" /><W3Content slot="w3" /><FormalCommutator slot="formal-commutator" /><FormalSquareRoot slot="formal-square-root" /><DressingSquare slot="dressing" /><BoundStates slot="bound-states" /><ScatteringChannels slot="scattering-intro" /><JostEnds slot="jost-intro" /><BoundTail slot="bound-tail-intro" /><Determinant slot="determinant" /><GlmContent slot="glm" /><MatchingFigure slot="matching" /><ImaginaryJost slot="imaginary-jost" /><PointSpectrum slot="joined-wave" mode="wave" /><ContourFigure slot="contour" /><ReconstructionFigure slot="reconstruction" /><TravelingSoliton slot="traveling" /><KdvSimulation slot="collision" mode="collision" /><KdvSimulation slot="breakup" mode="breakup" />
  <dialog slot="widgets" id="legacy-image-dialog" aria-label="Original figure">
        <div class="image-viewer-toolbar"><button type="button" id="image-zoom-out" aria-label="Zoom out">−</button><output id="image-zoom-value" aria-live="polite">100%</output><button type="button" id="image-zoom-in" aria-label="Zoom in">＋</button><button type="button" id="image-viewer-close">Close</button></div>
        <div id="legacy-image-scroll"><img id="legacy-image-expanded" alt="" /></div>
      </dialog>
</KdvBody>
<script>import '../scripts/widgets';</script>
