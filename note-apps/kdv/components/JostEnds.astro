---
import FigureViewport from './FigureViewport.astro';
import { createRequire } from 'node:module';
const require=createRequire(new URL('../../../package.json',import.meta.url));
const katex=createRequire(require.resolve('rehype-katex'))('katex');
const tex=(s:string)=>katex.renderToString(s,{throwOnError:true});
const potentialLeft=225, potentialRight=255;
const wave=(row:number)=>Array.from({length:121},(_,i)=>{
 const start=row===0?18:potentialRight, end=row===0?potentialLeft:462;
 const x=start+i*(end-start)/120;
 return `${i?'L':'M'}${x.toFixed(2)},${(row*168+94-15*Math.cos((x-240)*2.4/35)).toFixed(2)}`;
}).join(' ');
---
<figure id="scattering-intro-jost" class="jost-ends" aria-labelledby="jost-ends-caption">
 <FigureViewport width={480}><svg width="480" height="340" role="img" aria-labelledby="jost-ends-title jost-ends-desc">
  <title id="jost-ends-title">Minus: left end. Plus: right end.</title>
  <desc id="jost-ends-desc">Two separate rows show f minus and f plus. The left end of f minus is drawn and labeled e to the ikx as x tends to minus infinity. The right end of f plus is drawn and labeled with the same free wave as x tends to plus infinity. Only the normalized end is drawn as the real part of a free wave. A question mark replaces the unspecified profile in the rest of each row.</desc>
  <rect x={potentialLeft} y="40" width={potentialRight-potentialLeft} height="264" rx="12" fill="var(--line)" opacity=".5" />
  {[0,1].map(row=><>
   <foreignObject x="170" y={row*168} width="140" height="40"><div class="state-name" set:html={tex(row===0?'f_-(x,k)':'f_+(x,k)')} /></foreignObject>
   <path d={wave(row)} fill="none" stroke="var(--accent)" stroke-width="3.4" />
   <foreignObject x={row===0?275:115} y={row*168+70} width="90" height="55"><div class="unknown-wave" set:html={tex('\\text{?}')} /></foreignObject>
   <foreignObject x={row===0?10:potentialRight} y={row*168+43} width={row===0?potentialLeft-10:470-potentialRight} height="34"><div class="free-wave" set:html={tex('e^{ikx}')} /></foreignObject>
   <foreignObject x={row===0?0:potentialRight} y={row*168+132} width={row===0?potentialLeft:480-potentialRight} height="30"><div class="end-label" set:html={tex(row===0?'x\\to-\\infty':'x\\to+\\infty')} /></foreignObject>
  </>)}
  <foreignObject x="205" y="44" width="70" height="30"><div class="potential" set:html={tex('u(x)')} /></foreignObject>
 </svg></FigureViewport>
 <figcaption id="jost-ends-caption"><span set:html={tex('f_-')} /> は左端、<span set:html={tex('f_+')} /> は右端で <span set:html={tex('e^{ikx}')} /> に一致する。曲線は自由波の実部の模式図で、「?」の領域の波形は示していない。</figcaption>
</figure>
<style>
.jost-ends{scroll-margin-top:78px;width:100%;margin:1.5rem auto;color:var(--ink)}
.state-name,.free-wave,.end-label,.potential,.unknown-wave{display:flex;align-items:center;justify-content:center;width:100%;height:100%;white-space:nowrap;line-height:1}
.unknown-wave{font-size:40px;color:var(--muted)}
.state-name{font-size:26px}.free-wave{font-size:24px;color:var(--accent)}.end-label{font-size:21px;color:var(--accent)}.potential{font-size:18px;color:var(--muted)}
.jost-ends :global(.katex){color:inherit}.jost-ends figcaption{margin-top:10px;color:var(--muted);font-size:.88rem;line-height:1.65}
</style>
