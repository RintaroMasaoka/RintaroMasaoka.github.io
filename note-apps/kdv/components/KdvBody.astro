---
import { numberEquations } from '../../../src/utils/note-equations.mjs';
let html = await Astro.slots.render('default');
const chapter = (await Astro.slots.render('glm')).replace(/<h2(\s[^>]*)?>\d+\.\s*/g, '<h3$1>').replace(/<\/h2>/g, '</h3>');
const chapterPattern = /<div\s+data-chapter-slot=["']glm["']\s*>\s*<\/div>/;
if (!chapterPattern.test(html)) throw new Error('Missing KdV GLM chapter slot');
html = html.replace(chapterPattern, () => chapter);
for (const name of ['traveling', 'collision', 'breakup', 'bound-states']) {
  const visual = await Astro.slots.render(name);
  const pattern = new RegExp(`<div\\s+data-extra-visual=["']${name}["']\\s*>\\s*</div>`);
  if (!pattern.test(html)) throw new Error(`Missing KdV extra visual slot: ${name}`);
  html = html.replace(pattern, () => visual);
}
for (const name of ['contour', 'reconstruction', 'dyson-domain', 'green-matching', 'green-projector']) {
  const visual = await Astro.slots.render(name);
  const pattern = new RegExp(`<div\\s+data-visual-slot=["']${name}["']\\s*>\\s*</div>`);
  if (!pattern.test(html)) throw new Error(`Missing KdV visual slot: ${name}`);
  html = html.replace(pattern, () => visual);
}
html = numberEquations(html);
---
<article id="manuscript" set:html={html} />
