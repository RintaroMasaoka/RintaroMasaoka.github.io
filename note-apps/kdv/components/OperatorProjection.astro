---
import { createRequire } from 'node:module';
const rootRequire = createRequire(new URL('../../../package.json', import.meta.url));
const katex = createRequire(rootRequire.resolve('rehype-katex'))('katex');
const tex = (source: string) => katex.renderToString(source, { throwOnError: true });
const columns = ['\\text{Term}', '(\\,\\cdot\\,)_{\\ge0}', '\\operatorname{Res}(\\,\\cdot\\,)'];
const rows = [
  { term: 'a_1\\partial', projection: 'a_1\\partial', residue: '0', kept: true },
  { term: 'a_0', projection: 'a_0', residue: '0', kept: true },
  { term: '\\boxed{a_{-1}}\\,\\partial^{-1}', projection: '0', residue: '\\boxed{a_{-1}}', separator: true },
  { term: 'a_{-2}\\partial^{-2}', projection: '0', residue: '0' },
];
const caption = `各行は ${tex('A')} の項の例であり、右の二列はその項に操作を適用した結果を示す。非負冪を残す操作では、負冪の項は ${tex('0')} になる。留数として取り出される係数 ${tex('a_{-1}')} を枠で示した。`;
---
<figure class="kdv-operator-projection" aria-labelledby="kdv-operator-projection-caption">
  <table class="kdv-operator-table" aria-label="擬微分演算子の各項に対する非負冪の取り出しと留数">
    <thead><tr>{columns.map(label => <th scope="col"><span set:html={tex(label)} /></th>)}</tr></thead>
    <tbody>{rows.map(row => <tr class:list={{ 'negative-start': row.separator }}>
      <th scope="row"><span set:html={tex(row.term)} /></th>
      <td class:list={{ 'term-kept': row.kept, 'zero-result': !row.kept }}><span set:html={tex(row.projection)} /></td>
      <td class:list={{ 'residue-kept': row.separator, 'zero-result': !row.separator }}><span set:html={tex(row.residue)} /></td>
    </tr>)}</tbody>
  </table>
  <figcaption id="kdv-operator-projection-caption" set:html={caption} />
</figure>
<style>
.kdv-operator-projection{margin:2rem 0;border:1px solid var(--line);border-radius:12px;padding:1rem;background:var(--paper)}
:global(#manuscript) .kdv-operator-table{width:100%;max-width:480px;margin:0 auto;border-collapse:collapse;table-layout:fixed;font-size:16px;line-height:1.5}
:global(#manuscript) .kdv-operator-table :is(th,td){padding:12px 3px;text-align:center;font-weight:400;border-bottom:1px solid var(--line);vertical-align:middle;white-space:nowrap}
:global(#manuscript) .kdv-operator-table th:first-child{width:36%}
:global(#manuscript) .kdv-operator-table thead th{padding-top:6px;padding-bottom:15px;border-bottom:2px solid var(--muted)}
:global(#manuscript) .kdv-operator-table .negative-start :is(th,td){border-top:2px solid var(--muted)}
:global(#manuscript) .kdv-operator-table .term-kept{background:var(--soft);color:var(--ink)}
:global(#manuscript) .kdv-operator-table .residue-kept{background:var(--soft);color:var(--ink)}
:global(#manuscript) .kdv-operator-table .zero-result{color:var(--muted)}
:global(#manuscript) .kdv-operator-table tbody tr:last-child :is(th,td){border-bottom:0}
.kdv-operator-projection figcaption{color:var(--muted);font-size:.88rem;line-height:1.8;margin:.8rem .25rem 0}
</style>
