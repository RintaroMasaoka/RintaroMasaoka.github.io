---
import FigureViewport from './FigureViewport.astro';
import BoundStateControls from './BoundStateControls.astro';
import { createRequire } from 'node:module';
const require=createRequire(new URL('../../../package.json',import.meta.url));
const katex=createRequire(require.resolve('rehype-katex'))('katex');
const tex=(s:string)=>katex.renderToString(s,{throwOnError:true});
const panels=[{id:'full',title:'Jost magnitudes (natural log)',range:6,ys:[-12,-9,-6,-3,0,3,6]}];
---
<figure class="endpoint-matching" data-endpoint-matching aria-labelledby="green-matching-caption">
  <BoundStateControls id="matching-wave-number" />
  <div class="endpoint-w"><span set:html={tex('W(k)=' )} /><output data-matching-w></output></div>
  <FigureViewport width={900}>
  <svg width="100%" height="184" data-w-spectrum role="img" aria-label="Wronskian versus energy with one excited-state zero">
    <path data-w-axes fill="none" stroke="var(--muted)" />
    <path data-w-zero fill="none" stroke="var(--line)" stroke-dasharray="3 4" />
    <path data-w-curve fill="none" stroke="var(--accent)" stroke-width="2.5" />
    {[-1].map(e=><circle data-w-root={e} r="5" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />)}
    <circle data-w-selected r="4" fill="var(--accent)" />
    {[-1].map(e=><foreignObject data-w-energy={e} width="50" height="25" y="148"><div class="endpoint-tex" set:html={tex(String(e))} /></foreignObject>)}
    {[-.1,0,.05].map(y=><foreignObject data-w-tick={y} data-plot-tick={y} width="44" height="25" x="0"><div class="endpoint-tex" set:html={tex(String(y))} /></foreignObject>)}
    <foreignObject data-w-energy-axis width="24" height="25" y="125"><div class="endpoint-tex" set:html={tex('E')} /></foreignObject>
  </svg>
  <div class="endpoint-legend"><span class="endpoint-solid" aria-hidden="true"></span><span set:html={tex('\\log|f_-(x,-k)|')} /></div>
  <div class="endpoint-legend"><span class="endpoint-dashed" aria-hidden="true"></span><span set:html={tex('\\log|f_+(x,k)|')} /></div>
  {panels.map(panel=><section class="endpoint-panel">
    <div class="endpoint-heading" set:html={tex(`\\text{${panel.title}}`)} />
    <svg width="100%" height="224" data-matching-panel={panel.id} role="img" aria-label={panel.title}>
      <defs><clipPath id={`matching-${panel.id}-clip`}><rect data-matching-clip x="44" y="10" width="240" height="170" /></clipPath></defs>
      <path data-matching-axes fill="none" stroke="var(--muted)" />
      <path data-matching-guides fill="none" stroke="var(--line)" stroke-dasharray="3 4" />
      <g clip-path={`url(#matching-${panel.id}-clip)`}>
        <path data-matching-left fill="none" stroke="var(--accent)" stroke-width="4" />
        <path data-matching-right fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="6 4" />
      </g>
      {[-panel.range,0,panel.range].map(x=><foreignObject data-matching-x={x} width="42" height="25" y="195"><div class="endpoint-tex" set:html={tex(String(x))} /></foreignObject>)}
      {panel.ys.map(y=><foreignObject data-plot-tick={y} width="38" height="25" x="0"><div class="endpoint-tex" set:html={tex(String(y))} /></foreignObject>)}
      <foreignObject data-matching-axis width="24" height="25" y="157"><div class="endpoint-tex" set:html={tex('x')} /></foreignObject>
    </svg>
  </section>)}
  </FigureViewport>
  <p data-matching-status role="status" aria-live="polite"></p>
  <figcaption id="green-matching-caption">上段は <span set:html={tex('W(k)')} /> のエネルギー依存性、丸印は励起状態 <span set:html={tex('E=-1')} /> を示す。下段は Jost 解の絶対値の自然対数である。指数関数的な振る舞いは直線になり、<span set:html={tex('E=-1')} /> では両端で <span set:html={tex('\\log|f_\\pm|\\sim-|x|')} /> となる。二本の曲線は絶対値が等しいため重なる。原点の節では <span set:html={tex('\\log|f_\\pm|\\to-\\infty')} /> となり、描線は図の下端より下へ続く。</figcaption>
</figure>
<script>
  import { initMatchingFigure } from '../visuals/matching.js';
  initMatchingFigure();
</script>
<style>
.endpoint-matching{box-sizing:border-box;min-inline-size:0;width:100%;margin:2rem auto;padding:1rem;border:1px solid var(--line);border-radius:10px;background:var(--paper);color:var(--ink)}
.endpoint-matching label{display:flex;justify-content:space-between;align-items:baseline}
.endpoint-matching input{display:block;width:100%;min-width:0;min-height:44px;accent-color:var(--accent)}
.endpoint-matching button{min-height:44px;max-width:100%;padding:.4rem .7rem;margin:.2rem 0 .7rem;border:1px solid var(--line);border-radius:6px;background:var(--paper);color:var(--ink);cursor:pointer}
.endpoint-matching output{font-variant-numeric:tabular-nums}
.endpoint-legend{display:flex;align-items:center;gap:.6rem;min-height:32px;font-size:14px}
.endpoint-solid,.endpoint-dashed{display:inline-block;width:26px;flex:none;border-top:4px solid var(--accent)}
.endpoint-dashed{border-top:2px dashed var(--ink)}
.endpoint-heading{text-align:center;font-size:15px;margin:.8rem 0 .2rem}
.endpoint-matching svg{display:block;inline-size:100%;max-inline-size:100%;overflow:hidden}
.endpoint-tex{display:flex;align-items:center;justify-content:center;height:100%;font-size:14px;white-space:nowrap;color:var(--ink)}
.endpoint-slopes{font-size:14px;display:flex;flex-wrap:wrap;gap:.4rem 1rem;align-items:center;justify-content:space-between}
.endpoint-slopes>div{display:flex;gap:.5rem;align-items:center}
.endpoint-slopes output{min-width:3.5em;text-align:right}
.endpoint-w{display:flex;gap:.4rem;align-items:baseline;margin:.5rem 0;font-size:1rem;color:var(--ink);font-weight:normal}.endpoint-w output{font:inherit;font-variant-numeric:tabular-nums}
.endpoint-matching [data-matching-status]{font-size:14px;min-height:2.8em;margin:.5rem 0}
.endpoint-matching figcaption{font-size:.9rem;line-height:1.7}
</style>
