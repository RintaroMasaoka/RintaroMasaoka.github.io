---
import { createRequire } from 'node:module';
const rootRequire = createRequire(new URL('../../../package.json', import.meta.url));
const katex = createRequire(rootRequire.resolve('rehype-katex'))('katex');
const labels = [
  {x:490,y:232,w:100,t:'\\operatorname{Re}k'},
  {x:276,y:0,w:100,t:'\\operatorname{Im}k'},
  {x:38,y:252,w:60,t:'-R'}, {x:470,y:252,w:60,t:'R'},
  {x:231,y:252,w:50,t:'0'},
  {x:277,y:166,w:80,t:'i\\kappa_1'},
  {x:277,y:111,w:80,t:'i\\kappa_2'},
  {x:65,y:110,w:100,t:'\\Gamma_R'},
  {x:348,y:50,w:175,t:'y>x'},
  {x:10,y:289,w:580,t:'|e^{ik(y-x)}|=e^{-\\operatorname{Im}k(y-x)}'},
];
---
<figure class="kdv-contour" aria-labelledby="kdv-contour-caption">
  <svg viewBox="0 0 600 340" role="img" aria-labelledby="kdv-contour-title kdv-contour-desc">
    <title id="kdv-contour-title">Upper half-plane contour</title>
    <desc id="kdv-contour-desc">The real segment runs from minus R to R; the upper arc returns from R to minus R counterclockwise. Two schematic bound-state poles lie on the positive imaginary axis. The exponential decays above the real line when y is greater than x.</desc>
    <defs><marker id="kdv-contour-arrow" markerWidth="7" markerHeight="7" refX="5" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--accent)" /></marker><marker id="kdv-axis-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="var(--muted)" /></marker></defs>
    <path d="M64 245 A210 210 0 0 1 484 245 L64 245" fill="var(--accent)" opacity=".055" />
    {['M25 245 H565','M274 272 V25'].map(d=><path d={d} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#kdv-axis-arrow)" />)}
    <path d="M64 245 H484 A210 210 0 0 0 64 245" fill="none" stroke="var(--accent)" stroke-width="3" />
    {['M139 245 H198','M405 245 H442','M412 87 A210 210 0 0 0 350 49','M104 121 A210 210 0 0 0 78 170'].map(d=><path d={d} fill="none" stroke="var(--accent)" stroke-width="3" marker-end="url(#kdv-contour-arrow)" />)}
    <g fill="var(--ink)" stroke="var(--paper)" stroke-width="2"><circle cx="274" cy="181" r="5.5"/><circle cx="274" cy="126" r="5.5"/></g>
    {labels.map(l => <foreignObject x={l.x} y={l.y} width={l.w} height="37"><div class="tex-label" set:html={katex.renderToString(l.t,{throwOnError:true})}/></foreignObject>)}
  </svg>
  <figcaption id="kdv-contour-caption">実軸を左から右へ進み、上半円で戻る反時計回りの積分路。黒点は束縛状態の極の模式的位置で、極の個数や間隔を指定する図ではない。上半円の寄与を消すには、図の指数因子の減衰に加え、本文で示す残りの因子の評価を使う。</figcaption>
</figure>
<style>
.kdv-contour { margin:2rem 0; border:1px solid var(--line); border-radius:12px; padding:1rem; background:var(--paper); }
.kdv-contour svg { display:block; width:100%; height:auto; overflow:visible; }
.tex-label { color:var(--ink); font-size:21px; line-height:1.5; text-align:center; white-space:nowrap; }
.kdv-contour figcaption { color:var(--muted); font-size:.88rem; line-height:1.8; margin-top:.5rem; }
@media(max-width:480px){.kdv-contour{padding:.6rem .15rem}.tex-label{font-size:23px}}
</style>
