---
import FigureViewport from './FigureViewport.astro';
import { createRequire } from 'node:module';
const rootRequire = createRequire(new URL('../../../package.json', import.meta.url));
const katex = createRequire(rootRequire.resolve('rehype-katex'))('katex');
const labels = [
  {x:301,y:155,w:58,t:'\\operatorname{Re}k'},
  {x:177,y:0,w:68,t:'\\operatorname{Im}k'},
  {x:26,y:191,w:48,t:'-R'}, {x:278,y:191,w:48,t:'R'},
  {x:144,y:191,w:40,t:'0'},
  {x:184,y:132,w:58,t:'i\\kappa_1'},
  {x:184,y:95,w:58,t:'i\\kappa_2'},
  {x:247,y:38,w:85,t:'y<x'},
];
---
<figure class="kdv-contour" aria-labelledby="kdv-contour-caption">
  <FigureViewport width={420}><svg viewBox="0 0 360 229" role="img" aria-labelledby="kdv-contour-title kdv-contour-desc">
    <title id="kdv-contour-title">Upper half-plane contour</title>
    <desc id="kdv-contour-desc">The real segment runs from minus R to R; the upper arc returns from R to minus R counterclockwise. Two schematic bound-state poles lie on the positive imaginary axis. The exponential decays above the real line when y is less than x.</desc>
    <defs><marker id="kdv-contour-arrow" markerWidth="7" markerHeight="7" refX="5" refY="3.5" orient="auto"><path d="M0,0 L7,3.5 L0,7 Z" fill="var(--accent)" /></marker><marker id="kdv-axis-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto"><path d="M0,0 L6,3 L0,6 Z" fill="var(--muted)" /></marker></defs>
    <path d="M50 184 A126 126 0 0 1 302 184 L50 184" fill="var(--accent)" opacity=".055" />
    {['M15 184 H346','M176 204 V32'].map(d=><path d={d} fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#kdv-axis-arrow)" />)}
    <path d="M50 184 H302 A126 126 0 0 0 50 184" fill="none" stroke="var(--accent)" stroke-width="3" />
    {['M95 184 H131','M255 184 H277','M259 89 A126 126 0 0 0 222 66','M74 110 A126 126 0 0 0 58 139'].map(d=><path d={d} fill="none" stroke="var(--accent)" stroke-width="3" marker-end="url(#kdv-contour-arrow)" />)}
    <g fill="var(--ink)" stroke="var(--paper)" stroke-width="2"><circle cx="176" cy="148" r="4"/><circle cx="176" cy="111" r="4"/></g>
    {labels.map(l => <foreignObject x={l.x} y={l.y} width={l.w} height="31"><div class="tex-label" set:html={katex.renderToString(l.t,{throwOnError:true})}/></foreignObject>)}
  </svg></FigureViewport>
  <div class="kdv-contour-decay" set:html={katex.renderToString('|e^{ik(x-y)}|=e^{-\\operatorname{Im}k(x-y)}',{throwOnError:true})} />
  <figcaption id="kdv-contour-caption">実軸を左から右へ進み、上半円で戻る積分路。矢印は積分の向き、黒点は束縛状態の極を示す。極の配置は模式的である。</figcaption>
</figure>
<style>
.kdv-contour { margin:2rem 0; border:1px solid var(--line); border-radius:12px; padding:1rem; background:var(--paper); }
.kdv-contour svg { display:block; width:min(100%, 520px); margin:0 auto; height:auto; overflow:visible; }
.tex-label { color:var(--ink); font-size:18px; line-height:1.5; text-align:center; white-space:nowrap; }
.kdv-contour-decay {text-align:center;color:var(--ink);font-size:.95rem;white-space:nowrap;margin:.25rem 0 .75rem;}
.kdv-contour figcaption { color:var(--muted); font-size:.88rem; line-height:1.8; margin-top:.5rem; }
@media(max-width:480px){.kdv-contour{padding:.6rem .15rem}.tex-label{font-size:20px}.kdv-contour-decay{font-size:.82rem}}
</style>
