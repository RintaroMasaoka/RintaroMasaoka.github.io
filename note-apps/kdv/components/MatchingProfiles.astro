---
import { createRequire } from 'node:module';
import { MX, ZX, ZY } from '../visuals/green-response.js';
const require=createRequire(new URL('../../../package.json',import.meta.url));
const katex=createRequire(require.resolve('rehype-katex'))('katex');
const tex=(s:string)=>katex.renderToString(s,{throwOnError:true});
const {initial}=Astro.props;
const topLabels=[
 {x:60,y:0,w:240,t:'\\text{Full profiles}'},
 {x:0,y:30,w:98,t:'f/f(0)'}, {x:297,y:197,w:22,t:'x'},
 ...[-3,0,3].map(x=>({x:MX(x)-20,y:224,w:40,t:String(x)})),
];
const zoomLabels=[
 {x:60,y:0,w:240,t:'\\text{Near }x=0'},
 {x:0,y:30,w:98,t:'f/f(0)'}, {x:297,y:189,w:22,t:'x'},
 ...[.96,1,1.04].map(y=>({x:0,y:ZY(y)-15,w:43,t:String(y)})),
 ...[-.1,0,.1].map(x=>({x:ZX(x)-26,y:214,w:52,t:String(x)})),
];
---
<svg class="matching-plot" viewBox="0 0 320 258" role="img" aria-labelledby="green-matching-title green-matching-desc">
  <title id="green-matching-title">Two endpoint-decaying solutions on the same interval</title>
  <desc id="green-matching-desc">Both exact solutions are drawn from x minus three to three, each divided by its value at zero. The solid curve decays toward the left infinity and the dashed curve toward the right infinity. The linear amplitude axes stay fixed as energy changes. The shaded x interval is enlarged in the next plot.</desc>
  <defs><clipPath id="green-overview-clip"><rect x="52" y="56" width="248" height="170" /></clipPath></defs>
  <rect x={MX(-.1)} y="56" width={MX(.1)-MX(-.1)} height="162" fill="var(--accent)" opacity=".13" />
  <path d="M52 56 V218 H300" fill="none" stroke="var(--muted)" stroke-width="1" />
  <path data-green-zero d={`M52 ${initial.zeroY} H300`} stroke="var(--line)" />
  <path d={`M${MX(0)} 56 V218`} stroke="var(--line)" stroke-dasharray="3 5" />
  {initial.ticks.map(tick=><g transform={`translate(0,${tick.y})`}>
    <path d="M48 0 H52" stroke="var(--muted)" />
    <foreignObject x="0" y="-14" width="43" height="28"><div class="matching-tex" set:html={tex(String(tick.value))} /></foreignObject>
  </g>)}
  {[-3,0,3].map(x=><path d={`M${MX(x)} 218 v5`} stroke="var(--muted)" />)}
  <g clip-path="url(#green-overview-clip)">
    <path class="left-profile" data-green-path="overviewLeft" d={initial.overviewLeft} />
    <path class="right-profile" data-green-path="overviewRight" d={initial.overviewRight} />
  </g>
  <circle data-green-overview-point cx={MX(0)} cy={initial.overviewPoint[1]} r="3" fill="var(--ink)" />
  {topLabels.map(l=><foreignObject x={l.x} y={l.y} width={l.w} height="30"><div class="matching-tex" set:html={tex(l.t)} /></foreignObject>)}
</svg>
<svg class="matching-plot" viewBox="0 0 320 248" role="img" aria-labelledby="green-zoom-title green-zoom-desc">
  <title id="green-zoom-title">Magnified solutions near zero</title>
  <desc id="green-zoom-desc">The shaded interval from minus one tenth to one tenth is shown on fixed amplitude axes, zero point nine six to one point zero four. The two curves show the same solutions as in the overview. At energy minus one both complete solutions coincide.</desc>
  <defs><clipPath id="green-zoom-clip"><rect x="52" y="60" width="248" height="150" /></clipPath></defs>
  <path d="M52 60 V210 H300" fill="none" stroke="var(--muted)" stroke-width="1" />
  <path d={`M52 ${ZY(1)} H300 M${ZX(0)} 60 V210`} fill="none" stroke="var(--line)" stroke-dasharray="3 5" />
  {[.96,1,1.04].map(y=><path d={`M48 ${ZY(y)} H52`} stroke="var(--muted)" />)}
  {[-.1,0,.1].map(x=><path d={`M${ZX(x)} 210 v5`} stroke="var(--muted)" />)}
  <g clip-path="url(#green-zoom-clip)">
    <path class="left-profile" data-green-path="zoomLeft" d={initial.zoomLeft} />
    <path class="right-profile" data-green-path="zoomRight" d={initial.zoomRight} />
  </g>
  <circle cx={ZX(0)} cy={ZY(1)} r="3" fill="var(--ink)" />
  {zoomLabels.map(l=><foreignObject x={l.x} y={l.y} width={l.w} height="30"><div class="matching-tex" set:html={tex(l.t)} /></foreignObject>)}
</svg>
<div class="matching-legend">
  <div class="legend-head" set:html={tex('\\text{slope at }x=0')} />
  <div><span class="left-key" aria-hidden="true"></span><span set:html={tex('f_-(x,-k)/f_-(0,-k)')} /><output data-green-left-slope>{initial.leftSlope.toFixed(3)}</output></div>
  <div><span class="right-key" aria-hidden="true"></span><span set:html={tex('f_+(x,k)/f_+(0,k)')} /><output data-green-right-slope>{initial.rightSlope.toFixed(3)}</output></div>
</div>
<style>
.matching-plot{display:block;width:320px;height:auto}
.matching-tex{display:flex;align-items:center;justify-content:center;color:var(--ink);font-size:16px;line-height:1;height:100%;white-space:nowrap}
.matching-plot [hidden]{display:none}
.left-profile{fill:none;stroke:var(--accent);stroke-width:4}
.right-profile{fill:none;stroke:var(--ink);stroke-width:2.2;stroke-dasharray:6 4}
.matching-legend{width:320px;font-size:14px;color:var(--ink);margin:.2rem 0 .5rem}
.matching-legend>div:not(.legend-head){display:flex;align-items:center;gap:.3rem;min-height:32px}
.matching-legend output{margin-left:auto;font-variant-numeric:tabular-nums;font-size:15px}
.legend-head{text-align:right;font-size:13px;margin-bottom:.3rem}
.left-key,.right-key{display:block;width:23px;flex:none;border-top:3px solid var(--accent)}
.right-key{border-top:2px dashed var(--ink)}
</style>
