  "units": [
    {
      "id": "S1",
      "text": "# Costello\u306e\u69cb\u6210\u3068\u672c\u30ce\u30fc\u30c8\u306e\u76ee\u7684"
    },
    {
      "id": "S2",
      "text": "\u3042\u308b\u5024\u306b\u5e73\u5747\u30bc\u30ed\u306e\u63fa\u3089\u304e\u3092\u52a0\u3048\u3001\u305d\u306e\u56db\u4e57\u3092\u5e73\u5747\u3059\u308b\u3002"
    },
    {
      "id": "S3",
      "text": "\u5143\u306e\u5024\u306b\u63fa\u3089\u304e\u306e\u5e73\u5747\u3092\u8db3\u3057\u3066\u304b\u3089\u56db\u4e57\u3059\u308b\u8a08\u7b97\u3068\u3001\u63fa\u3089\u304e\u3092\u52a0\u3048\u305f\u5024\u3092\u56db\u4e57\u3057\u3066\u304b\u3089\u5e73\u5747\u3059\u308b\u8a08\u7b97\u306f\u540c\u3058\u306b\u306a\u308b\u3060\u308d\u3046\u304b\u3002"
    },
    {
      "id": "S4",
      "text": "\u3069\u3061\u3089\u3082\u540c\u3058\u5143\u306e\u5024\u3068\u63fa\u3089\u304e\u3092\u4f7f\u3046\u304c\u3001\u8a08\u7b97\u306e\u9806\u5e8f\u304c\u9055\u3046\u3002"
    },
    {
      "id": "S5",
      "text": "\u4e8c\u9805\u5c55\u958b\u3092\u4f7f\u3048\u3070\u3001\u3053\u306e\u9055\u3044\u3092\u8abf\u3079\u3089\u308c\u308b\u3002"
    },
    {
      "id": "S6",
      "text": "\u3053\u3053\u3067\u306f\u30ac\u30a6\u30b9\u578b\u306e\u63fa\u3089\u304e\u3092\u8003\u3048\u3001\u6b63\u8ca0\u306e\u5024\u304c\u540c\u3058\u91cd\u307f\u3067\u73fe\u308c\u308b\u3002"
    },
    {
      "id": "S7",
      "text": "\u305d\u306e\u305f\u3081\u5947\u6570\u4e57\u306e\u5e73\u5747\u306f\u6d88\u3048\u3066\u3082\u3001\u4e8c\u4e57\u3084\u56db\u4e57\u306e\u5e73\u5747\u306f\u6b8b\u308b\u3002"
    },
    {
      "id": "S8",
      "text": "\u56db\u4e57\u3092\u5e73\u5747\u3057\u305f\u7d50\u679c\u306b\u306f\u3001\u5143\u306e\u5024\u306e\u56db\u6b21\u306e\u9805\u3060\u3051\u3067\u306a\u304f\u3001\u4e8c\u6b21\u306e\u9805\u3084\u5b9a\u6570\u9805\u3082\u73fe\u308c\u308b\u3002"
    },
    {
      "id": "S9",
      "text": "\u5148\u306b\u63fa\u3089\u304e\u3092\u5e73\u5747\u3059\u308b\u8a08\u7b97\u3067\u306f\u5143\u306e\u5024\u306b\u623b\u308b\u306e\u3067\u3001\u3053\u306e\u4e8c\u6b21\u9805\u3068\u5b9a\u6570\u9805\u3092\u53d6\u308a\u51fa\u305b\u306a\u3044\u3002"
    },
    {
      "id": "S10",
      "text": "\u5e73\u5747\u306e\u9806\u5e8f\u3092\u533a\u5225\u3059\u308c\u3070\u3001\u63fa\u3089\u304e\u3092\u7121\u8996\u3057\u3066\u5143\u306e\u56db\u6b21\u9805\u3060\u3051\u3092\u6b8b\u3059\u8a08\u7b97\u306b\u3001\u4f55\u304c\u8db3\u308a\u306a\u3044\u304b\u3092\u8abf\u3079\u3089\u308c\u308b\u3002"
    }
  ],
