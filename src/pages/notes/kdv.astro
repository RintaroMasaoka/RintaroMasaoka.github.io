---
import '../../../note-apps/kdv/scripts/check-section-sync.mjs';
import StudyNoteLayout from '../../layouts/StudyNoteLayout.astro';
import '../../../note-apps/kdv/styles/figures.css';
import { Content as GlmContent, getHeadings as getGlmHeadings } from '../../../note-apps/kdv/content/glm.md';
import { Content, getHeadings } from '../../../note-apps/kdv/content/full.md';
import KdvBody from '../../../note-apps/kdv/components/KdvBody.astro';
import config from '../../../note-apps/kdv/note.config.json';
import DysonDomain from '../../../note-apps/kdv/components/DysonDomain.astro';
import PointSpectrum from '../../../note-apps/kdv/components/PointSpectrum.astro';
import MatchingFigure from '../../../note-apps/kdv/components/MatchingFigure.astro';
import ContourFigure from '../../../note-apps/kdv/components/ContourFigure.astro';
import ReconstructionFigure from '../../../note-apps/kdv/components/ReconstructionFigure.astro';
import TravelingSoliton from '../../../note-apps/kdv/components/TravelingSoliton.astro';
import Determinant from '../../../note-apps/kdv/components/Determinant.astro';
import BoundStates from '../../../note-apps/kdv/components/BoundStates.astro';
import KdvSimulation from '../../../note-apps/kdv/components/KdvSimulation.astro';
const sourceHeadings = getHeadings().filter(h => h.depth === 2 || h.depth === 3).map(h => ({...h, text: h.text.replace(/\$/g, '').replace(/\\psi/g, 'ψ')})).flatMap(h => [h, ...(h.depth === 2 && h.text.startsWith('3.') ? getGlmHeadings().filter(g => g.depth === 2).map(g => ({...g, depth: 3, text: g.text.replace(/^\d+\.\s*/, '')})) : [])]);

const headings = sourceHeadings.map(h => ({id: h.slug, depth: h.depth, labelHtml: h.text.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;'), href: `#${h.slug}`}));
---
<StudyNoteLayout note={config} headings={headings} numbering="site">
  <KdvBody><Content /><BoundStates slot="bound-states" /><Determinant slot="determinant" /><GlmContent slot="glm" /><MatchingFigure slot="matching" /><PointSpectrum slot="joined-wave" mode="wave" /><PointSpectrum slot="point-spectrum" /><ContourFigure slot="contour" /><DysonDomain slot="dyson-domain" /><ReconstructionFigure slot="reconstruction" /><TravelingSoliton slot="traveling" /><KdvSimulation slot="collision" mode="collision" /><KdvSimulation slot="breakup" mode="breakup" /></KdvBody>
  <dialog slot="widgets" id="legacy-image-dialog" aria-label="Original figure">
        <div class="image-viewer-toolbar"><button type="button" id="image-zoom-out" aria-label="Zoom out">−</button><output id="image-zoom-value" aria-live="polite">100%</output><button type="button" id="image-zoom-in" aria-label="Zoom in">＋</button><button type="button" id="image-viewer-close">Close</button></div>
        <div id="legacy-image-scroll"><img id="legacy-image-expanded" alt="" /></div>
      </dialog>
</StudyNoteLayout>
<script>import '../../../note-apps/kdv/scripts/widgets';</script>
