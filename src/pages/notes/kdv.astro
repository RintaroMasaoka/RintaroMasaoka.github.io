---
import { Content, getHeadings } from '../../../note-apps/kdv/content/glm.md';
import KdvBody from '../../../note-apps/kdv/components/KdvBody.astro';
import config from '../../../note-apps/kdv/note.config.json';
import ContourFigure from '../../../note-apps/kdv/components/ContourFigure.astro';
import ReconstructionFigure from '../../../note-apps/kdv/components/ReconstructionFigure.astro';
const headings = getHeadings().filter(h => h.depth === 2).map(h => ({...h, text: h.text.replace(/^\d+\.\s*/, '')}));
---
<!doctype html>
<html lang={config.language}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={config.chapters[0].plainDescription} />
  <title>{config.chapters[0].plainTitle} | {config.title}</title>
  <link rel="stylesheet" href="/notes/KdV/katex/katex.min.css" />
  <script is:inline>
    try { if ((localStorage.getItem('kdv.theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')) === 'dark') document.documentElement.classList.add('dark'); } catch {}
  </script>
</head>
<body>
  <div id="reading-progress" aria-hidden="true"></div>
  <a class="skip" href="#main">本文へ移動</a>
  <header class="reader-header">
    <a class="back" href="/ja/notes/" aria-label="ノート一覧へ戻る">← <span>Notes</span></a>
    <a class="reader-title" href="#top">{config.title}</a>
    <button id="theme-button" type="button" aria-label="配色を切り替える">配色</button>
  </header>
  <div class="reading-layout">
    <aside class="index" aria-label="ページ内の目次">
      <div class="index-heading">{config.chapters[0].plainTitle}</div>
      <nav><ol>{headings.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>
      <div class="originals">
        <a href="/notes/KdV/source/数理班_政岡凜太郎.pdf">元のノート全文 ↗</a>
        <a href="/notes/KdV/source/KdV.tex">LaTeX ソース ↗</a>
      </div>
    </aside>
    <main id="main" tabindex="-1">
      <header id="top" class="chapter-head">
        <p class="eyebrow">INVERSE SCATTERING</p>
        <h1>{config.chapters[0].title}</h1>
        <p class="deck">{config.description}</p>
      </header>
      <details class="mobile-index"><summary>目次を開く</summary><nav><ol>{headings.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav></details>
      <div class="reading-actions"><button type="button" id="expand-details">補足をすべて開く</button><button type="button" id="collapse-details">補足をすべて閉じる</button></div>
      <KdvBody><Content /><ContourFigure slot="contour" /><ReconstructionFigure slot="reconstruction" /></KdvBody>
      <div id="equation-preview" role="dialog" aria-label="参照した数式" hidden><button id="close-equation" type="button" aria-label="数式プレビューを閉じる">閉じる ×</button><div id="equation-preview-content"></div></div>
      <footer class="note-footer"><a href="/ja/notes/">← ノート一覧</a><a href="#top">ページの先頭へ ↑</a></footer>
    </main>
  </div>
  <script>
    import { initKdvVisuals } from '../../../note-apps/kdv/visuals/contours.js';
    initKdvVisuals();
    document.getElementById('theme-button')?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try { localStorage.setItem('kdv.theme', dark ? 'dark' : 'light'); } catch {}
    });
    for (const [id, open] of [['expand-details', true], ['collapse-details', false]] as const) {
      document.getElementById(id)?.addEventListener('click', () => {
        document.querySelectorAll<HTMLDetailsElement>('#manuscript details').forEach(el => el.open = open);
      });
    }
    const preview = document.getElementById('equation-preview')!;
    const previewContent = document.getElementById('equation-preview-content')!;
    const equations = new Map<string, Element>();
    document.querySelectorAll('#manuscript .katex-display').forEach(eq => {
      const tag = eq.querySelector('.tag')?.textContent?.match(/\((\d+)\)/);
      if (tag) equations.set(tag[1], eq);
    });
    const walker = document.createTreeWalker(document.getElementById('manuscript')!, NodeFilter.SHOW_TEXT);
    const textNodes: Text[] = [];
    for (let n = walker.nextNode(); n; n = walker.nextNode()) {
      const text = n as Text;
      if (!text.parentElement?.closest('.katex, a, button, summary, h2, h3, code, svg') && /\(\d+\)/.test(text.data)) textNodes.push(text);
    }
    let pinned = false, anchor: HTMLButtonElement | null = null;
    const close = () => { preview.hidden = true; pinned = false; anchor?.setAttribute('aria-expanded','false'); };
    const show = (button: HTMLButtonElement, number: string, pin = false) => {
      if (pinned && !pin) return;
      if (pinned && anchor === button && pin) { close(); return; }
      anchor?.setAttribute('aria-expanded','false'); anchor = button; pinned = pin;
      previewContent.replaceChildren(equations.get(number)!.cloneNode(true));
      preview.hidden = false; button.setAttribute('aria-expanded','true');
      const rect = button.getBoundingClientRect();
      preview.style.left = `${Math.max(12, Math.min(rect.left, innerWidth - preview.offsetWidth - 12))}px`;
      preview.style.top = `${Math.max(76, Math.min(rect.bottom + 10, innerHeight - preview.offsetHeight - 16))}px`;
    };
    for (const text of textNodes) {
      const fragment = document.createDocumentFragment(); let offset = 0;
      for (const match of text.data.matchAll(/\((\d+)\)/g)) {
        if (!equations.has(match[1])) continue;
        fragment.append(text.data.slice(offset, match.index));
        const button = document.createElement('button'); button.className = 'equation-reference'; button.type = 'button';
        button.textContent = match[0]; button.setAttribute('aria-label',`式 ${match[1]} を確認`);button.setAttribute('aria-expanded','false');button.setAttribute('aria-controls','equation-preview');
        button.addEventListener('click',()=>show(button,match[1],true));
        button.addEventListener('mouseenter',()=>show(button,match[1]));
        button.addEventListener('mouseleave',()=>{if(!pinned)close()});
        fragment.append(button); offset = match.index! + match[0].length;
      }
      if (offset) { fragment.append(text.data.slice(offset)); text.replaceWith(fragment); }
    }
    document.getElementById('close-equation')?.addEventListener('click',()=>{const restore=anchor;close();restore?.focus()});
    document.addEventListener('keydown',e=>{if(e.key==='Escape'){const restore=anchor;close();restore?.focus()}});
    document.addEventListener('click',e=>{if(!preview.contains(e.target as Node)&&!((e.target as Element).closest?.('.equation-reference')))close()});
    const progress = () => { const available=document.documentElement.scrollHeight-innerHeight; document.getElementById('reading-progress')!.style.width=`${available>0?100*scrollY/available:0}%`; };
    addEventListener('scroll',progress,{passive:true});addEventListener('resize',()=>{close();progress()});document.addEventListener('toggle',progress,true);progress();
    const reveal = () => {
      if (!location.hash) return;
      let id; try { id = decodeURIComponent(location.hash.slice(1)); } catch { return; }
      const target = document.getElementById(id);
      if (target instanceof HTMLDetailsElement) target.open = true;
      for (let p = target?.parentElement; p; p = p.parentElement) if (p instanceof HTMLDetailsElement) p.open = true;
      target?.scrollIntoView();
    };
    addEventListener('hashchange', reveal); reveal();
    document.addEventListener('click', event => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
      if (link?.hash === location.hash) reveal();
    });
    const observer = new IntersectionObserver(entries => {
      for (const e of entries) if (e.isIntersecting) {
        document.querySelectorAll('.index nav a').forEach(a => {
          const active = a.getAttribute('href') === `#${e.target.id}`;
          if (active) a.setAttribute('aria-current','location'); else a.removeAttribute('aria-current');
        });
      }
    }, { rootMargin: '-15% 0px -65% 0px' });
    document.querySelectorAll('#manuscript h2').forEach(h => observer.observe(h));
  </script>
</body>
</html>
<style is:global>
  :root{color-scheme:light;--paper:#f4f3ef;--surface:#fbfaf7;--ink:#202c29;--muted:#5b6862;--line:#d8ddd6;--accent:#265b4b;--blue:#355e8a;--soft:#eef1eb}
  :root.dark{color-scheme:dark;--paper:#141b18;--surface:#1b2420;--ink:#e1e8df;--muted:#acb9ae;--line:#3b4941;--accent:#a4d1b7;--blue:#a8c8e5;--soft:#222f28}
  *{box-sizing:border-box}html{scroll-behavior:auto;scroll-padding-top:84px}body{margin:0;background:var(--paper);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN","Yu Gothic",sans-serif}a{color:var(--accent);text-underline-offset:4px}button,input{font:inherit;color:inherit}button,summary{cursor:pointer}button{background:transparent;border:1px solid var(--line);border-radius:5px;padding:9px 13px}button:hover{background:var(--soft)}:focus-visible{outline:3px solid var(--blue);outline-offset:4px}button:focus:not(:focus-visible){outline:none}.skip{position:fixed;left:10px;top:-90px;z-index:100;background:var(--surface);padding:12px}.skip:focus{top:10px}
  .reader-header{position:sticky;top:0;z-index:20;height:65px;display:flex;align-items:center;gap:24px;padding:0 28px;background:var(--paper);border-bottom:1px solid var(--line)}.reader-header a{text-decoration:none}.back{font-size:14px;white-space:nowrap}.reader-title{font-family:"Hiragino Mincho ProN","Yu Mincho",serif;font-size:18px;font-weight:600;letter-spacing:.04em}.reader-header button{margin-left:auto;font-size:12px}
  .reading-layout{max-width:1440px;margin:auto;display:grid;grid-template-columns:255px minmax(0,1fr)}.index{position:sticky;top:65px;height:calc(100vh - 65px);padding:42px 26px;border-right:1px solid var(--line);overflow:auto}.index-heading{font-size:13px;letter-spacing:.04em;color:var(--muted);margin-bottom:20px}.index ol{list-style:none;margin:0;padding:0;counter-reset:section}.index li{counter-increment:section;margin:0 0 8px}.index nav a{display:block;font-size:13px;line-height:1.6;padding:9px 0;text-decoration:none;color:var(--muted)}.index nav a::before{content:counter(section,decimal-leading-zero);font-family:ui-monospace,monospace;font-size:10px;margin-right:9px;color:var(--accent)}.index nav a[aria-current]{color:var(--accent);font-weight:700}.originals{display:grid;gap:14px;margin-top:36px;padding-top:26px;border-top:1px solid var(--line);font-size:12px}.originals a{text-decoration:none}
  main{min-width:0;background:var(--surface);padding:54px clamp(24px,5vw,80px) 32px}.chapter-head{padding-bottom:28px;border-bottom:1px solid var(--line);margin-bottom:24px}.eyebrow{font-size:11px;color:var(--accent);letter-spacing:.18em;margin:0 0 18px}.chapter-head h1{font:500 clamp(28px,3.5vw,42px)/1.5 "Hiragino Mincho ProN","Yu Mincho",serif;letter-spacing:.02em;margin:0 0 14px}.deck{font-size:14px;line-height:1.9;color:var(--muted);margin:0}.reading-actions{display:flex;gap:10px;justify-content:flex-end;margin-bottom:32px}.reading-actions button{font-size:11px;border:none;padding:7px 3px;text-decoration:underline;text-underline-offset:4px}.mobile-index{display:none}
  #manuscript{font:16px/2.05 "Hiragino Mincho ProN","Yu Mincho",serif;overflow-wrap:break-word}#manuscript p{margin:0 0 22px}#manuscript h2{font-size:24px;line-height:1.6;font-weight:600;margin:62px 0 24px;padding-top:26px;border-top:1px solid var(--line);scroll-margin-top:85px}#manuscript h2:first-child{margin-top:16px;border-top:none;padding-top:0}#manuscript h3{font-size:18px;margin:32px 0 16px}#manuscript ul{padding-left:24px}#manuscript li{margin:7px 0}#manuscript blockquote{margin:26px 0;padding:18px 22px;border-left:3px solid var(--accent);background:var(--soft)}#manuscript blockquote p:last-child{margin:0}#manuscript .katex-display{overflow-x:auto;overflow-y:hidden;padding:10px 2px;margin:20px 0;font-size:.95em}#manuscript details{border:1px solid var(--line);border-radius:6px;background:var(--paper);padding:0 20px;margin:25px 0;font-size:15px}#manuscript details summary{font:500 13px/1.7 -apple-system,BlinkMacSystemFont,"Hiragino Kaku Gothic ProN",sans-serif;padding:16px 0;color:var(--accent)}#manuscript details[open] summary{margin-bottom:16px;border-bottom:1px solid var(--line)}#manuscript details p:last-child{margin-bottom:18px}#manuscript figure{margin:30px 0}#manuscript figcaption{font:13px/1.8 -apple-system,BlinkMacSystemFont,sans-serif;color:var(--muted);margin-top:14px}#manuscript svg{max-width:100%;height:auto}#manuscript table{border-collapse:collapse;width:100%;font-size:14px}#manuscript th,#manuscript td{border-bottom:1px solid var(--line);padding:10px;text-align:left}
  .note-footer{display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:24px;margin-top:64px;font-size:12px}button,input{min-height:38px}.visual-card{font-family:-apple-system,BlinkMacSystemFont,sans-serif;line-height:1.7}.visual-card label{font-size:13px}.visual-card input[type=range]{accent-color:var(--accent);max-width:100%}
  #reading-progress{position:fixed;z-index:30;left:0;top:0;height:3px;background:var(--accent);width:0;pointer-events:none}#equation-preview{position:fixed;z-index:50;width:min(680px,calc(100vw - 24px));max-height:calc(100vh - 100px);overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:16px;box-shadow:0 12px 40px #0002}#equation-preview[hidden]{display:none}#close-equation{display:block;margin-left:auto;font-size:11px}#equation-preview .katex-display{overflow-x:auto;overflow-y:hidden;font-size:.9em;padding:8px 0}#manuscript .equation-reference{display:inline;border:0;border-bottom:1px dotted var(--accent);border-radius:0;padding:0 2px;min-height:0;color:var(--accent);font:inherit;line-height:inherit}
  @media(min-width:1450px){main{padding-right:100px}}@media(max-width:850px){.reading-layout{grid-template-columns:1fr}.index{display:none}main{padding:34px 24px}.reader-header{padding:0 18px;gap:16px}.reader-title{font-size:15px}.mobile-index{display:block;margin:24px 0;font-size:13px;border:1px solid var(--line);border-radius:5px;padding:12px 16px}.mobile-index summary{color:var(--accent)}.mobile-index li{padding:5px 0}.reading-actions{margin-bottom:22px}#manuscript{font-size:15.5px}#manuscript h2{font-size:22px;margin-top:48px}.back span{display:none}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
  @media print{:root,:root.dark{color-scheme:light;--paper:#fff;--surface:#fff;--ink:#111;--muted:#555;--line:#ccc;--accent:#265b4b;--blue:#355e8a}.reader-header,.index,.reading-actions,.mobile-index,#reading-progress,#equation-preview{display:none}main{padding:0}.reading-layout{display:block}details{break-inside:avoid}.note-footer{display:none}}
</style>
